derive_pll_clocks
derive_clock_uncertainty

# core specific constraints
#
# Three clocks from one PLL, phase aligned: clk_sys 80.64 MHz (outclk_0: SDRAM controller, arbiter, loader, hps_io), the DSP clock 40.32 MHz (outclk_1: the DSP, its program RAM, the
# codec model) and clk_cpu 20.16 MHz (outclk_2: the 186, the glue, the DTE UART). clk_sys = 2 x clk_dsp = 4 x clk_cpu exactly. Every core runs at its full clock (no multicycle
# exceptions): the paths between the domains are the single registers of the handshakes in rtl/cdc.sv and rtl/ram/xdom_req.sv, timed by STA between aligned edges.

# SDRAM_CLK is generated by an altddio_out from clk_sys inside sdram.sv (inverted clock). Delays and the read data multicycle are the ones
# validated on a DE10-Nano by ../unixpc (3B1.sdc); see there for the derivation (data captured on the 4th controller edge after READ).
create_generated_clock -name SDRAM_CLK -source [get_pins {emu|pll|pll_inst|altera_pll_i|*[0].*|divclk}] -invert [get_ports {SDRAM_CLK}]
set_input_delay  -clock SDRAM_CLK -max 6.4 [get_ports {SDRAM_DQ[*]}]
set_input_delay  -clock SDRAM_CLK -min 3.2 [get_ports {SDRAM_DQ[*]}]
set_output_delay -clock SDRAM_CLK -max 1.5 [get_ports {SDRAM_DQ[*] SDRAM_A[*] SDRAM_BA[*] SDRAM_nCS SDRAM_nCAS SDRAM_nRAS SDRAM_nWE SDRAM_CKE SDRAM_DQML SDRAM_DQMH}]
set_output_delay -clock SDRAM_CLK -min -0.8 [get_ports {SDRAM_DQ[*] SDRAM_A[*] SDRAM_BA[*] SDRAM_nCS SDRAM_nCAS SDRAM_nRAS SDRAM_nWE SDRAM_CKE SDRAM_DQML SDRAM_DQMH}]
set_multicycle_path -setup 2 -from [get_clocks {SDRAM_CLK}] -to [get_clocks {*|pll|pll_inst|altera_pll_i|*[0].*|divclk}]


# the registered reset tree
set_false_path -from [get_registers {*|modem_core:modem|rst_n_q}]

# The heartbeat text on the DTE pin (dbg_status, clocked by the 50 MHz reference) reads quasi-static debug counters from every domain: not timed.
set_false_path -to [get_registers {*|dbg_status:dbg|*}]
