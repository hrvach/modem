+/* Answer mode (started by ATA: the dial string is empty): there is no outgoing call, an incoming one is answered at once. The soft modem is
+   already off hook sending its answer tone, so the caller hears it from the first packet. */
+static void on_incoming_call(pjsua_acc_id acc_id, pjsua_call_id call_id, pjsip_rx_data *rdata) {
+	(void)acc_id; (void)rdata;
+	pjsua_call_answer(call_id, 200, NULL, NULL);
+}
